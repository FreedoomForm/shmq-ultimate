@@ -0,0 +1,195 @@
+// Copyright (c) Microsoft Corporation.
+// SPDX-License-Identifier: MIT
+
+#include <ATen/cuda/CUDAContext.h>
+#include <ATen/Dispatch.h>
+#include <ATen/Functions.h>
+#include <ATen/Tensor.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAException.h>
+#include <torch/library.h>
+
+#include <cuda.h>
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+namespace {
+
+constexpr int kThreads = 128;
+
+template <typename scalar_t>
+__device__ __forceinline__ float load_activation(const scalar_t* input,
+                                                  int64_t offset) {
+  return static_cast<float>(input[offset]);
+}
+
+template <typename scalar_t>
+__global__ void three_level_partition_kernel(
+    const scalar_t* input, const uint8_t* packed_int4,
+    const __half* scale_int4, const uint8_t* zero_int4,
+    const int32_t* indices_int4, const int8_t* weight_int8,
+    const __half* scale_int8, const int32_t* indices_int8,
+    const __half* weight_fp16, const int32_t* indices_fp16, float* output,
+    int64_t rows, int64_t width, int64_t output_width, int64_t n4,
+    int64_t n8, int64_t n16, int64_t group_size) {
+  const int64_t row = blockIdx.y;
+  const int64_t partition_channel = blockIdx.x;
+  const int64_t groups = width / group_size;
+  const int64_t packed_width = width / 2;
+  float accumulator = 0.0f;
+
+  if (partition_channel < n4) {
+    const int64_t channel = partition_channel;
+    for (int64_t k = threadIdx.x; k < width; k += blockDim.x) {
+      const uint8_t packed = packed_int4[channel * packed_width + k / 2];
+      const uint8_t code = (k & 1) ? (packed >> 4) : (packed & 0x0f);
+      const int64_t group = channel * groups + k / group_size;
+      const float dequantized =
+          (static_cast<float>(code) - static_cast<float>(zero_int4[group])) *
+          __half2float(scale_int4[group]);
+      accumulator += load_activation(input, row * width + k) * dequantized;
+    }
+  } else if (partition_channel < n4 + n8) {
+    const int64_t channel = partition_channel - n4;
+    for (int64_t k = threadIdx.x; k < width; k += blockDim.x) {
+      const float dequantized =
+          static_cast<float>(weight_int8[channel * width + k]) *
+          __half2float(scale_int8[channel * groups + k / group_size]);
+      accumulator += load_activation(input, row * width + k) * dequantized;
+    }
+  } else {
+    const int64_t channel = partition_channel - n4 - n8;
+    for (int64_t k = threadIdx.x; k < width; k += blockDim.x) {
+      accumulator += load_activation(input, row * width + k) *
+                     __half2float(weight_fp16[channel * width + k]);
+    }
+  }
+
+  __shared__ float reduction[kThreads];
+  reduction[threadIdx.x] = accumulator;
+  __syncthreads();
+  for (int offset = kThreads / 2; offset > 32; offset >>= 1) {
+    if (threadIdx.x < offset) {
+      reduction[threadIdx.x] += reduction[threadIdx.x + offset];
+    }
+    __syncthreads();
+  }
+  if (threadIdx.x < 32) {
+    float value = reduction[threadIdx.x] + reduction[threadIdx.x + 32];
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+      value += __shfl_down_sync(0xffffffff, value, offset);
+    }
+    if (threadIdx.x == 0) {
+      int32_t output_channel;
+      if (partition_channel < n4) {
+        output_channel = indices_int4[partition_channel];
+      } else if (partition_channel < n4 + n8) {
+        output_channel = indices_int8[partition_channel - n4];
+      } else {
+        output_channel = indices_fp16[partition_channel - n4 - n8];
+      }
+      output[row * output_width + output_channel] = value;
+    }
+  }
+}
+
+void check_cuda_contiguous(const at::Tensor& tensor, const char* name) {
+  TORCH_CHECK(tensor.is_cuda(), name, " must be a CUDA tensor");
+  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
+}
+
+at::Tensor three_level_linear_cuda(
+    const at::Tensor& input, const at::Tensor& weight_int4,
+    const at::Tensor& scale_int4, const at::Tensor& zero_int4,
+    const at::Tensor& indices_int4, const at::Tensor& weight_int8,
+    const at::Tensor& scale_int8, const at::Tensor& indices_int8,
+    const at::Tensor& weight_fp16, const at::Tensor& indices_fp16,
+    int64_t group_size) {
+  check_cuda_contiguous(input, "input");
+  check_cuda_contiguous(weight_int4, "weight_int4");
+  check_cuda_contiguous(scale_int4, "scale_int4");
+  check_cuda_contiguous(zero_int4, "zero_int4");
+  check_cuda_contiguous(indices_int4, "indices_int4");
+  check_cuda_contiguous(weight_int8, "weight_int8");
+  check_cuda_contiguous(scale_int8, "scale_int8");
+  check_cuda_contiguous(indices_int8, "indices_int8");
+  check_cuda_contiguous(weight_fp16, "weight_fp16");
+  check_cuda_contiguous(indices_fp16, "indices_fp16");
+  TORCH_CHECK(input.dim() == 2, "input must have shape [rows, in_features]");
+  TORCH_CHECK(input.scalar_type() == at::kHalf ||
+                  input.scalar_type() == at::kFloat,
+              "input must be float16 or float32");
+  TORCH_CHECK(weight_int4.scalar_type() == at::kByte,
+              "weight_int4 must be uint8");
+  TORCH_CHECK(scale_int4.scalar_type() == at::kHalf,
+              "scale_int4 must be float16");
+  TORCH_CHECK(zero_int4.scalar_type() == at::kByte,
+              "zero_int4 must be uint8");
+  TORCH_CHECK(weight_int8.scalar_type() == at::kChar,
+              "weight_int8 must be int8");
+  TORCH_CHECK(scale_int8.scalar_type() == at::kHalf,
+              "scale_int8 must be float16");
+  TORCH_CHECK(weight_fp16.scalar_type() == at::kHalf,
+              "weight_fp16 must be float16");
+  TORCH_CHECK(indices_int4.scalar_type() == at::kInt &&
+                  indices_int8.scalar_type() == at::kInt &&
+                  indices_fp16.scalar_type() == at::kInt,
+              "all channel indices must be int32");
+  TORCH_CHECK(group_size > 0 && input.size(1) % group_size == 0,
+              "group_size must divide in_features");
+
+  const auto rows = input.size(0);
+  const auto width = input.size(1);
+  const auto n4 = indices_int4.numel();
+  const auto n8 = indices_int8.numel();
+  const auto n16 = indices_fp16.numel();
+  const auto output_width = n4 + n8 + n16;
+  TORCH_CHECK(output_width > 0, "at least one precision partition is required");
+  TORCH_CHECK(weight_int4.size(0) == n4 && weight_int4.size(1) == width / 2,
+              "invalid packed INT4 weight shape");
+  TORCH_CHECK(weight_int8.size(0) == n8 && weight_int8.size(1) == width,
+              "invalid INT8 weight shape");
+  TORCH_CHECK(weight_fp16.size(0) == n16 && weight_fp16.size(1) == width,
+              "invalid FP16 weight shape");
+  const auto groups = width / group_size;
+  TORCH_CHECK(scale_int4.size(0) == n4 && scale_int4.size(1) == groups &&
+                  zero_int4.size(0) == n4 && zero_int4.size(1) == groups,
+              "invalid INT4 scale/zero shape");
+  TORCH_CHECK(scale_int8.size(0) == n8 && scale_int8.size(1) == groups,
+              "invalid INT8 scale shape");
+
+  c10::cuda::CUDAGuard device_guard(input.device());
+  auto output = at::empty({rows, output_width}, input.options().dtype(at::kFloat));
+  const cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+  const dim3 block(kThreads);
+  const dim3 grid(output_width, rows);
+
+  AT_DISPATCH_FLOATING_TYPES_AND_HALF(input.scalar_type(), "three_level_sm75", [&] {
+    three_level_partition_kernel<scalar_t><<<grid, block, 0, stream>>>(
+        input.data_ptr<scalar_t>(), weight_int4.data_ptr<uint8_t>(),
+        reinterpret_cast<const __half*>(scale_int4.data_ptr<at::Half>()),
+        zero_int4.data_ptr<uint8_t>(), indices_int4.data_ptr<int32_t>(),
+        weight_int8.data_ptr<int8_t>(),
+        reinterpret_cast<const __half*>(scale_int8.data_ptr<at::Half>()),
+        indices_int8.data_ptr<int32_t>(),
+        reinterpret_cast<const __half*>(weight_fp16.data_ptr<at::Half>()),
+        indices_fp16.data_ptr<int32_t>(), output.data_ptr<float>(), rows, width,
+        output_width, n4, n8, n16, group_size);
+  });
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  return output;
+}
+
+}  // namespace
+
+TORCH_LIBRARY(mixllm_sm75, m) {
+  m.def("three_level_linear(Tensor input, Tensor weight_int4, Tensor scale_int4, "
+        "Tensor zero_int4, Tensor indices_int4, Tensor weight_int8, "
+        "Tensor scale_int8, Tensor indices_int8, Tensor weight_fp16, "
+        "Tensor indices_fp16, int group_size) -> Tensor");
+}
+
+TORCH_LIBRARY_IMPL(mixllm_sm75, CUDA, m) {
+  m.impl("three_level_linear", &three_level_linear_cuda);
+}
